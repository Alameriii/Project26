# Copy to backend/.env and adjust. Never commit the real .env.

# Database. Leave unset to use a local SQLite file (backend/circular_campus.db).
# PostgreSQL (the target database from Phases 2-3):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/circular_campus

# AI service. Leave unset to use the local rule-based fallback.
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# AI_TIMEOUT_SECONDS=10

# Set to true when the app is served over HTTPS so the session cookie is HTTPS-only.
# COOKIE_SECURE=false
